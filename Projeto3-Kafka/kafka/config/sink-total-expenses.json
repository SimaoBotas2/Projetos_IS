{
    "name": "jdbc-sink-total-expenses",
    "config": {
        "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
        "connection.url": "jdbc:postgresql://database:5432/project3?user=postgres&password=nopass",
        "dialect.name": "PostgreSqlDatabaseDialect",
        "tasks.max": "1",
        "topics": "Results-total-expenses",
        "table.name.format": "total_metrics",
        "auto.create": "false",
        "auto.evolve": "false",
        "insert.mode": "upsert",
        "pk.mode": "record_value",
        "pk.fields": "metric_name",
        "key.converter": "org.apache.kafka.connect.storage.StringConverter",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter.schemas.enable": "false",
        "transforms": "AddMetricName,RenameValue,DropMetaFields",
        "transforms.AddMetricName.type": "org.apache.kafka.connect.transforms.InsertField$Value",
        "transforms.AddMetricName.static.field": "metric_name",
        "transforms.AddMetricName.static.value": "total_expenses",
        "transforms.RenameValue.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.RenameValue.renames": "value:metric_value",
        "transforms.DropMetaFields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.DropMetaFields.exclude": "key,timestamp"
    }
}
